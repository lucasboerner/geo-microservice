{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		# Shed load instead of queueing forever: a request still waiting for a free
		# PHP thread after this long is rejected rather than held until the client times out.
		max_wait_time {$FRANKENPHP_MAX_WAIT_TIME:10s}
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	@phpRoute {
		not file {path}
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		# Each request holds a worker while it waits on Photon/OSRM, so the worker
		# count — not the CPU — caps concurrency. FrankenPHP's default (2x CPUs) is
		# sized for CPU-bound apps; this gateway mostly waits on I/O.
		worker {
			file ./public/index.php
			num {$FRANKENPHP_WORKERS:32}
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
